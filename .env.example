# ===========================================================================
# MechAI Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
#
# Rule: Never commit secrets or actual production credentials to version control.
# Reference: docs/engineering/06-configuration-philosophy.md
# ===========================================================================

# Application Settings
MECHAI_APP_NAME=mechai
MECHAI_ENV=development
MECHAI_DEBUG=false

# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
MECHAI_LOG_LEVEL=INFO
# Format: console (coloured human-readable for dev) | json (structured for production)
MECHAI_LOG_FORMAT=console
