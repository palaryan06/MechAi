# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file, utf-8 charset
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Data and configuration files (2 spaces)
[*.{yml,yaml,json,jsonl,toml}]
indent_size = 2

# Markdown files (allow trailing spaces for manual line breaks)
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Python source files
[*.py]
indent_size = 4
max_line_length = 100

# Shell scripts
[*.{sh,bash}]
indent_size = 2

# Windows batch files
[*.bat]
end_of_line = crlf
